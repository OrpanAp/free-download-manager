# ============================================================
# Zephyr Download Manager - .gitignore
# Python + PySide6 + PyInstaller + Inno Setup + browser extension
# ============================================================

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments (build_exe.bat creates .venv in the project) ---
.venv/
venv/
env/
ENV/

# --- PyInstaller output (build_exe.bat) ---
build/
dist/
*.spec
*.manifest
!browser-extension/manifest.json
!browser-extension/manifest.firefox.json

# --- Release folder (Zephyr.exe, runtime\ffmpeg.exe, runtime\deno.exe,
#     copied icon and extension are all regenerated by build_exe.bat) ---
release/
runtime/
*.exe
*.dll
*.pyd

# --- Inno Setup output (installer\Output\Zephyr-Setup.exe) ---
installer/Output/
Output/

# --- Downloaded build helpers ---
deno.zip
deno.exe
ffmpeg.exe

# --- Runtime data (Zephyr stores these in ~\.zephyrdm, but ignore
#     them in case they are ever created inside the project) ---
.zephyrdm/
downloads.json
config.json
*.log
*.part
*.ytdl
*.tmp

# --- Test downloads created while developing ---
Downloads/
Zephyr/

# --- Packaged browser extension builds (keep the store zip tracked
#     by editing or removing the rule below if you want to ignore it) ---
browser-extension/*.zip
browser-extension/*.crx
browser-extension/*.xpi
web-ext-artifacts/
*.pem

# --- Secrets ---
.env
.env.*
*.key

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- GitKraken (the repo has a .git/gk folder) ---
.gk/
