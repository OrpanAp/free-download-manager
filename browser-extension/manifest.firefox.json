{
  "manifest_version": 3,
  "name": "Zephyr Integration",
  "version": "2.0",
  "description": "Sends downloads and videos to Zephyr, like the IDM extension.",
  "permissions": [
    "downloads",
    "contextMenus",
    "cookies",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zephyr-dm@local"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zephyr",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
